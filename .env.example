# 复制成 .env（本地）或写进 Cloudflare 的 Secrets（生产）
# 前端只用 PUBLIC_ 前缀的变量，不要在这里放密钥给前端

PUBLIC_APP_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:8787

# 后端 secrets：用 `wrangler secret put <NAME>` 写入
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com

# 只给本地 wrangler dev 用；生产用 D1 绑定，不需要这个
DATABASE_URL=
