<mxfile host="flowtable" version="24.0.0"><diagram id="02-user-journey" name="用户旅程与变现：从一次搜索到一笔订阅"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="search" value="&lt;b&gt;搜索长尾词&lt;/b&gt;&lt;br&gt;clean csv online&lt;br&gt;fix csv encoding" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="190" height="64" as="geometry"/></mxCell><mxCell id="landing" value="&lt;b&gt;工具落地页&lt;/b&gt;&lt;br&gt;一个词 = 一个页面&lt;br&gt;无注册即可用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF4FF;strokeColor=#C7D7FB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="246" y="90" width="190" height="64" as="geometry"/></mxCell><mxCell id="tool" value="&lt;b&gt;免费清洗&lt;/b&gt;&lt;br&gt;浏览器内，不上传&lt;br&gt;逐格 diff 建立信任" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF4FF;strokeColor=#C7D7FB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="472" y="90" width="190" height="64" as="geometry"/></mxCell><mxCell id="paywall" value="&lt;b&gt;付费触发点&lt;/b&gt;&lt;br&gt;第 3 次上传 / 想保存规则&lt;br&gt;想每天自动跑" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2F8;strokeColor=#FBCFE8;fontColor=#9D174D;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="698" y="90" width="190" height="64" as="geometry"/></mxCell><mxCell id="signup" value="&lt;b&gt;注册（邮箱）&lt;/b&gt;&lt;br&gt;Free 1 条管道&lt;br&gt;手动跑" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF4FF;strokeColor=#C7D7FB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="924" y="90" width="200" height="64" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;建管道&lt;/b&gt;&lt;br&gt;选源 → 选规则 → 选目标&lt;br&gt;TTFV 目标 &lt; 10 分钟" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF4FF;strokeColor=#C7D7FB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="924" y="250" width="200" height="64" as="geometry"/></mxCell><mxCell id="firstrun" value="&lt;b&gt;首次运行&lt;/b&gt;&lt;br&gt;真实数据跑通&lt;br&gt;看到 before/after" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="698" y="250" width="190" height="64" as="geometry"/></mxCell><mxCell id="daily" value="&lt;b&gt;每日自动刷新&lt;/b&gt;&lt;br&gt;托管表 + CSV&lt;br&gt;行数历史" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="472" y="250" width="190" height="64" as="geometry"/></mxCell><mxCell id="alert" value="&lt;b&gt;行数异常告警&lt;/b&gt;&lt;br&gt;±20% 或归零&lt;br&gt;邮件先于老板" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="246" y="250" width="190" height="64" as="geometry"/></mxCell><mxCell id="upgrade" value="&lt;b&gt;升级 Pro&lt;/b&gt;&lt;br&gt;$19 → $49&lt;br&gt;按管道数计价" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2F8;strokeColor=#FBCFE8;fontColor=#9D174D;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="190" height="64" as="geometry"/></mxCell><mxCell id="outreach" value=