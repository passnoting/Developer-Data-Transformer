<mxfile host="flowtable" version="24.0.0"><diagram id="01-architecture" name="系统架构：一条管道怎么跑完"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="web_tools" value="&lt;b&gt;免费工具页&lt;/b&gt;&lt;br&gt;Astro 静态 · /tools/*&lt;br&gt;SEO 长尾入口，文件不上传" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF4FF;strokeColor=#C7D7FB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="24" y="78" width="232" height="66" as="geometry"/></mxCell><mxCell id="web_app" value="&lt;b&gt;应用界面&lt;/b&gt;&lt;br&gt;管道列表 / 运行日志&lt;br&gt;逐格 diff + 撤销" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF4FF;strokeColor=#C7D7FB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="24" y="160" width="232" height="66" as="geometry"/></mxCell><mxCell id="engine_wasm" value="&lt;b&gt;浏览器清洗引擎&lt;/b&gt;&lt;br&gt;同一份 core，跑在 WASM&lt;br&gt;5MB 内免费不限次" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF4FF;strokeColor=#C7D7FB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="24" y="242" width="232" height="66" as="geometry"/></mxCell><mxCell id="chrome_ext" value="&lt;b&gt;Chrome 扩展（可选）&lt;/b&gt;&lt;br&gt;从当前页面抓表&lt;br&gt;只做漏斗，不做收银台" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="24" y="324" width="232" height="66" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API 路由 /api/*&lt;/b&gt;&lt;br&gt;Bearer 鉴权 · CORS&lt;br&gt;建管道 / 手动跑 / 查运行" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="78" width="250" height="66" as="geometry"/></mxCell><mxCell id="cron" value="&lt;b&gt;Cron 调度器&lt;/b&gt;&lt;br&gt;每日 06:00 / 每小时（Pro）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="250" height="60" as="geometry"/></mxCell><mxCell id="runner" value="&lt;b&gt;管道执行器&lt;/b&gt;&lt;br&gt;fetch → transform → validate&lt;br&gt;→ snapshot → alert&lt;br&gt;失败/异常都留日志" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="236" width="250" height="92" as="geometry"/></mxCell><mxCell id="alerts" value="&lt;b&gt;告警器&lt;/b&gt;&lt;br&gt;行数 ±20% / 运行失败" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="344" width="250" height="60" as="geometry"/></mxCell><mxCell id="billing" value="&lt;b&gt;计费 webhook&lt;/b&gt;&lt;br&gt;Creem 验签 → 订阅状态" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2F8;strokeColor=#FBCFE8;fontColor=#9D174D;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="420" width="250" height="60" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;D1 元数据&lt;/b&gt;&lt;br&gt;workspace / pipeline / rules&lt;br&gt;runs / subscriptions&lt;br&gt;不存原始数据" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#FED7AA;fontColor=#9A3412;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="664" y="78" width="226" height="92" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;R2 快照&lt;/b&gt;&lt;br&gt;最新一次结果 + meta&lt;br&gt;7 天自动过期" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#FED7AA;fontColor=#9A3412;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="664" y="186" width="226" height="66" as="geometry"/></mxCell><mxCell id="hosted" value="&lt;b&gt;托管表页 /t/:token&lt;/b&gt;&lt;br&gt;只读页面 + CSV 下载" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#FED7AA;fontColor=#9A3412;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="664" y="268" width="226" height="66" as="geometry"/></mxCell><mxCell id="sources" value="&lt;b&gt;数据源 API&lt;/b&gt;&lt;br&gt;任意 REST / JSON（分页 / 鉴权）&lt;br&gt;Shopify · Stripe 预置" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F5F3FF;strokeColor=#DDD6FE;fontColor=#5B21B6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="78" width="268" height="92" as="geometry"/></mxCell><mxCell id="creem" value="&lt;b&gt;Creem（MoR）&lt;/b&gt;&lt;br&gt;3.9% + $0.40 · 代缴 VAT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDF2F8;strokeColor=#FBCFE8;fontColor=#9D174D;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="186" width="268" height="60" as="geometry"/></mxCell><mxCell id="dest" value="&lt;b&gt;客户的表&lt;/b&gt;&lt;br&gt;Google Sheets / Excel&lt;br&gt;IMPORTDATA 或直接下 CSV" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F5F3FF;strokeColor=#DDD6FE;fontColor=#5B21B6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="268" width="268" height="66" as="geometry"/></mxCell><mxCell id="resend" value="&lt;b&gt;Resend&lt;/b&gt;&lt;br&g