<mxfile host="flowtable" version="24.0.0"><diagram id="03-release" name="发布与运维：从一次 commit 到客户看到新数据"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="local" value="&lt;b&gt;本地开发&lt;/b&gt;&lt;br&gt;pnpm dev / dev:api&lt;br&gt;node 直接跑 TS 测试" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EEF4FF;strokeColor=#C7D7FB;fontColor=#1E3A8A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="200" height="70" as="geometry"/></mxCell><mxCell id="push" value="&lt;b&gt;git push&lt;/b&gt;&lt;br&gt;feature 分支" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="96" width="180" height="70" as="geometry"/></mxCell><mxCell id="preview" value="&lt;b&gt;Cloudflare Pages 构建&lt;/b&gt;&lt;br&gt;预览 URL（每个 PR 一个）&lt;br&gt;静态产物 apps/web/dist" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="96" width="210" height="70" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;冒烟检查&lt;/b&gt;&lt;br&gt;工具页能跑&lt;br&gt;/api/health 通" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#334155;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="96" width="180" height="70" as="geometry"/></mxCell><mxCell id="prod" value="&lt;b&gt;合并 main → 生产&lt;/b&gt;&lt;br&gt;Pages 自动部署&lt;br&gt;域名 + 缓存刷新" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;align=le