---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found · FlowTable" description="That page doesn't exist.">
  <section class="hero">
    <div class="wrap">
      <h1 style="font-size:40px">404</h1>
      <p class="lead">That page doesn't exist — probably a typo, or a tool we haven't built yet.</p>
      <div class="cta">
        <a class="btn primary" href="/tools/clean-csv">Clean a CSV</a>
        <a class="btn" href="/tools/">All tools</a>
      </div>
    </div>
  </section>
</Base>
